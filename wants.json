name: Auto-Sync Palia Weekly Wants

on:
  schedule:
    # Runs Monday at 10:00 UTC (6:00 PM SGT)
    - cron: '0 10 * * 1'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Scrape Wants from palia.gaming.tools
        run: |
          python - << 'EOF'
          import json
          import re
          import sys
          import urllib.request
          from datetime import datetime

          PAGE_URL = "https://palia.gaming.tools/tools/weekly-wants"
          HEADERS = {
              "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Mobile/15E148 Safari/604.1",
              "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
          }

          KNOWN_VILLAGERS = [
              "Ashura", "Auni", "Badruu", "Caleri", "Chayne", "Delaila", "Einar",
              "Elouisa", "Eshe", "Hassian", "Hekla", "Hodari", "Jel", "Jina",
              "Kenli", "Kenyatta", "Nai'o", "Najuma", "Reth", "Sifuu", "Subira",
              "Tamala", "Tau", "The Gardener", "Tish", "Ulfe", "Zeki"
          ]

          VILLAGER_LOCATIONS = {
              "Ashura": "Kilima Tavern",
              "Auni": "Tavern / Fields",
              "Badruu": "Daiya Farm",
              "Caleri": "Library",
              "Chayne": "Apothecary",
              "Delaila": "Daiya Farm",
              "Einar": "Fisherman Lagoon",
              "Elouisa": "Kilima Village",
              "Eshe": "Mayor's Estate",
              "Hassian": "Kilima Outskirts",
              "Hekla": "Mirror Pond Ruins",
              "Hodari": "Bahari Bay",
              "Jel": "Tailor Shop",
              "Jina": "Mirror Pond Ruins",
              "Kenli": "Town Hall",
              "Kenyatta": "Town Hall / Stables",
              "Nai'o": "Daiya Farm",
              "Najuma": "Bahari Workshop",
              "Reth": "Kilima Tavern",
              "Sifuu": "Blacksmith Shop",
              "Subira": "Inn Upstairs",
              "Tamala": "Bahari Woods",
              "Tau": "Village / Farm",
              "The Gardener": "Temple of the Roots",
              "Tish": "Furniture Store",
              "Ulfe": "Bahari Bay",
              "Zeki": "General Store"
          }

          try:
              print(f"Connecting to: {PAGE_URL}")
              req = urllib.request.Request(PAGE_URL, headers=HEADERS)
              with urllib.request.urlopen(req, timeout=30) as res:
                  raw_content = res.read().decode('utf-8')

              villagers_dict = {}

              # Strategy 1: Look for Next.js / Nuxt hydration payload (__NEXT_DATA__ or similar)
              json_blob = None
              next_data_match = re.search(r'<script id="__NEXT_DATA__" type="application/json">({.*?})</script>', raw_content)
              
              if next_data_match:
                  try:
                      parsed = json.loads(next_data_match.group(1))
                      # Recursively find villager objects or lists in props
                      page_props = parsed.get("props", {}).get("pageProps", {})
                      json_blob = page_props.get("villagers") or page_props.get("data") or page_props
                  except Exception as err:
                      print(f"Failed parsing __NEXT_DATA__: {err}")

              # Strategy 2: If structured JSON blob is retrieved
              if isinstance(json_blob, list):
                  for item in json_blob:
                      v_name = item.get("name") or item.get("villagerName")
                      wants_list = item.get("wants") or item.get("weeklyWants") or []
                      if v_name in KNOWN_VILLAGERS and wants_list:
                          formatted_wants = []
                          for w in wants_list:
                              w_name = w.get("name") if isinstance(w, dict) else str(w)
                              is_love = bool(w.get("love") or w.get("isLoved") or w.get("rewardTier", 0) >= 3) if isinstance(w, dict) else False
                              formatted_wants.append({"name": w_name, "love": is_love})
                          villagers_dict[v_name] = formatted_wants[:4]

              # Strategy 3: HTML DOM fallback for rendered cards
              if len(villagers_dict) < 15:
                  print("Falling back to DOM container extraction...")
                  # Identify blocks per villager
                  for v in KNOWN_VILLAGERS:
                      pattern = rf"{v}[\s\S]*?(?=(?:{'|'.join(KNOWN_VILLAGERS)})|$)"
                      match = re.search(pattern, raw_content)
                      if match:
                          block = match.group(0)
                          # Extract likely item names or alt text inside the villager card
                          items = re.findall(r'alt="([^"]+)"|title="([^"]+)"|<span[^>]*>([^<]+)</span>', block)
                          clean_items = []
                          for t in items:
                              candidate = (t[0] or t[1] or t[2]).strip()
                              if (candidate 
                                  and len(candidate) > 2 
                                  and candidate.lower() not in ["like", "love", "gift", "item", "icon", "star", v.lower()]
                                  and candidate not in KNOWN_VILLAGERS
                                  and candidate not in clean_items):
                                  clean_items.append(candidate)

                          if len(clean_items) >= 2:
                              villagers_dict[v] = [
                                  {"name": name, "love": idx >= 2} 
                                  for idx, name in enumerate(clean_items[:4])
                              ]

              print(f"Extracted data for {len(villagers_dict)} villagers.")

              formatted_list = []
              for name in KNOWN_VILLAGERS:
                  if name in villagers_dict:
                      formatted_list.append({
                          "name": name,
                          "loc": VILLAGER_LOCATIONS.get(name, "Kilima / Bahari"),
                          "wants": villagers_dict[name]
                      })

              # Safety Gate: Do not overwrite if extraction came back partial
              if len(formatted_list) < 15:
                  print("Warning: Insufficient villagers extracted. Aborting without overwriting wants.json.", file=sys.stderr)
                  sys.exit(0)

              output = {
                  "updated_at": datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC"),
                  "source": "palia.gaming.tools",
                  "villagers": formatted_list
              }

              with open("wants.json", "w", encoding="utf-8") as f:
                  json.dump(output, f, indent=2, ensure_ascii=False)

              print(f"Success: wants.json generated successfully from palia.gaming.tools!")

          except Exception as e:
              print(f"Scraper error: {e}", file=sys.stderr)
              sys.exit(0)
          EOF

      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add wants.json
          if git diff --staged --quiet; then
            echo "No changes in wants.json to commit."
          else
            git commit -m "chore(data): sync weekly wants from palia.gaming.tools [skip ci]"
            git push origin HEAD:${{ github.ref_name }}
          fi
